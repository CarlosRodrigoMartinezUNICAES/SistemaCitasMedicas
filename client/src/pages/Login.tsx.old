  color: var(--text-primary);.card-icon {

}  width: 80px;

`;  height: 80px;

  margin: 0 auto 24px;

interface LoginProps {  display: flex;

  userType: 'Paciente' | 'Doctor';  align-items: center;

  onBack: () => void;  justify-content: center;

}  background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);

  border-radius: 20px;

const Login: React.FC<LoginProps> = ({ userType, onBack }) => {  font-size: 40px;

  const [username, setUsername] = useState("");  transition: transform 0.3s ease;

  const [password, setPassword] = useState("");}

  const [error, setError] = useState("");.card:hover .card-icon { transform: scale(1.1) rotate(5deg); }

  const [loading, setLoading] = useState(false);.card-icon.medical { background: linear-gradient(135deg, #dcfce7 0%, #d1fae5 100%); }



